<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.Driver.ViewModels"
             x:Class="Mobile.Driver.Pages.InTripPage"
             x:DataType="vm:InTripViewModel"
             Style="{StaticResource AppPage}"
             Title="В поездке">
    <Grid Padding="20" RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1" Spacing="18">
            <Frame BackgroundColor="{StaticResource BrandSoft}" CornerRadius="60"
                   HeightRequest="120" WidthRequest="120" Padding="0"
                   HasShadow="False" BorderColor="Transparent" HorizontalOptions="Center">
                <Label Text="🚖" FontSize="68" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <Label Style="{StaticResource Title2Label}" HorizontalOptions="Center" Text="{Binding StatusText}" />
            <Button Style="{StaticResource SuccessButton}" Text="✓ Завершить поездку"
                    Command="{Binding CompleteCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Inverter}}" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
            <Label Style="{StaticResource ErrorLabel}" HorizontalOptions="Center" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Mobile.Rider.Converters"
             xmlns:local="clr-namespace:Mobile.Rider"
             x:Class="Mobile.Rider.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InverterConverter x:Key="Inverter" />
            <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

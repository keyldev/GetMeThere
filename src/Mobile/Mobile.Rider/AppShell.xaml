<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Mobile.Rider.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Mobile.Rider.Pages"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent Title="Вход" ContentTemplate="{DataTemplate pages:LoginPage}" Route="login" />
    <ShellContent Title="Регистрация" ContentTemplate="{DataTemplate pages:RegisterPage}" Route="register" />
    <ShellContent Title="Карта" ContentTemplate="{DataTemplate pages:MapPage}" Route="map" />
    <ShellContent Title="Ожидание" ContentTemplate="{DataTemplate pages:WaitingPage}" Route="waiting" />
    <ShellContent Title="В пути" ContentTemplate="{DataTemplate pages:TripPage}" Route="trip" />
    <ShellContent Title="Готово" ContentTemplate="{DataTemplate pages:CompletePage}" Route="complete" />

</Shell>
